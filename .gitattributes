# The calculators under calculators/dist/ are GENERATED by
#   node calculators/build.mjs
# Pin these paths to LF so a rebuild is byte-identical on Windows, macOS and
# Linux. Without this, core.autocrlf=true rewrites every line on a Windows
# rebuild and `git status` reports the whole generated file as modified, which
# hides real changes and makes the build look non-reproducible.
calculators/*.src.html   text eol=lf
calculators/dist/*.html  text eol=lf
calculators/build.mjs    text eol=lf
parameters/*.js          text eol=lf
parameters/*.mjs         text eol=lf
parameters/*.json        text eol=lf
